# ===========================================================================
# JANANIMART — environment variable template
# ===========================================================================
# Copy this file to `.env` locally (or export the variables in your server
# environment). NEVER commit a real `.env` file — it holds secrets.
#
# Java servlet apps like JanuMart read these from the process environment;
# there is no .env loader at runtime by default. On Tomcat, export them before
# starting the server, e.g.:
#   ... or in the Tomcat setenv.bat / setenv.sh:
#   set AI_PROVIDER_API_KEY=sk-...
# ===========================================================================

# --- Janu AI Shopping Assistant (OpenAI-compatible chat completions) -------
# REQUIRED for live AI replies. Set to your provider key (OpenAI, Groq,
# OpenRouter, or any OpenAI-compatible endpoint).
# When unset, the assistant runs in "catalog" mode: honest replies built from
# the real JanuMart catalog, clearly not presented as AI output.
AI_PROVIDER_API_KEY=

# Optional overrides (defaults shown):
AI_ENABLED=false
# Default: https://api.openai.com/v1  (e.g. https://api.groq.com/openai/v1)
AI_BASE_URL=
# Default: gpt-4o-mini
AI_MODEL=
# Default: 20 (seconds)
AI_TIMEOUT_SECONDS=